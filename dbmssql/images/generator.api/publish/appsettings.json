{
  // ДОБАВЛЯЕМ СЕКЦИЮ НАСТРОЕК АУТЕНТИФИКАЦИИ:
  "AuthSettings": {
    "ValidationUrl": "http://localhost:5080/v1/identity/api/internal-auth/validate"
  },
  "GeneratorSettings": {
    "DwhClientsRoot": "../dwhclients",
    "MetadataJsonFileName": "MetaData.json"
  },
  "ProfileSettings": {
    "BaseUrl": "http://localhost:5080/v1/identity"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "Microsoft.AspNetCore": "Debug",
        "System": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "[{@t:HH:mm:ss.ff}] [{@l:u3}] {#if ClientName is not null}[{ClientName}] {#end}{#if Verb is not null}[{Verb}] {#end}{#if SqlDialect is not null}[{SqlDialect}] {#end}{@m}{#if DurationMs is not null} ({DurationMs} ms){#end}\n{@x}"
          }
        }
      },

      {
        "Name": "File",
        "Args": {
          "path": "../logs/GeneratorDWH-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": "128000",
          "retainedFileCountLimit": 3,
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {Timestamp: @t, Level: @l, Message: @m, ClientName: ClientName, Verb: Verb, SqlDialect: SqlDialect, DurationMs: DurationMs, Properties: @p} }\n"
            //"template": "[{@t:HH:mm:ss.ff}] [{@l:u3}] {@m} Context:{#if SourceContext is not null} [{SourceContext}]{#end}\n{@x}"
          }

        }
      }
    ],
    "Properties": {
      "Application": "GeneratorDWH"
    }
  }

}
