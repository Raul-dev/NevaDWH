анилище и портале доступными за секунды.\n\n\r\n\r\n\n---\n\n\r\n\r\n\n## Что получает заказчик"}},{"id":"22cec346-5bc6-47e8-8537-5335a8b133ff","values":[-0.033481206744909286,-0.03124196082353592,-0.06964493542909622,-0.028657248243689537,-0.07694493234157562,-0.015634991228580475,0.00967313814908266,0.10078911483287811,-0.04579590633511543,0.06088709458708763,-0.03196868300437927,0.025882434099912643,0.10864066332578659,-0.046699732542037964,-0.04147271811962128,-0.004137177020311356,-0.03054482489824295,0.02697037346661091,0.025520600378513336,0.05206162855029106,-0.01881396770477295,-0.0882166400551796,0.06020208075642586,-0.0684204250574112,0.032846178859472275,0.03345831483602524,-0.08542568236589432,0.02279811166226864,-0.08154132962226868,0.07115861028432846,-0.05851346254348755,0.07284998893737793,0.03433719649910927,-0.050510093569755554,-0.0066238525323569775,0.0007754878024570644,0.03712591901421547,0.006067239213734865,-0.020159747451543808,0.0421590730547905,-0.06841624528169632,0.02811606600880623,-0.13663509488105774,0.04728265479207039,-0.0643378496170044,-0.015199940651655197,-0.029191628098487854,-0.02108224667608738,-0.14518824219703674,-0.021277885884046555,-0.08208757638931274,0.019825391471385956,0.03454584628343582,0.024102240800857544,-0.03477106988430023,-0.13622084259986877,-0.05504567176103592,0.020619450137019157,-0.02962198480963707,-0.027323881164193153,-0.052096087485551834,-0.054847948253154755,0.00956546887755394,-0.03168449178338051,0.04537958651781082,0.06992402672767639,-0.0031465748324990273,-0.03759415075182915,0.028064340353012085,-0.011950718238949776,0.032855477184057236,0.0032617899123579264,-0.09891494363546371,-0.04047189652919769,-0.0568745955824852,0.056104935705661774,0.0041536190547049046,0.024090759456157684,-0.10723467916250229,-0.10224006325006485,0.08161044865846634,0.04387720674276352,0.018296420574188232,0.010233670473098755,-0.06901402026414871,-0.017131779342889786,0.040660664439201355,0.030376821756362915,0.0